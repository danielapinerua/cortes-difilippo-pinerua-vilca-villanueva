# Copiar este archivo como ".env" y completar con tus datos locales.
# El archivo ".env" NO se sube a git (tiene contraseñas).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tech_solutions

# Clave para firmar los tokens de login. Poné un texto largo y al azar; NO la compartas.
# Se puede generar con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-un-texto-largo-y-secreto

# Origen del frontend que puede llamar a la API (CORS).
# Con "python -m http.server 5500" en la carpeta del frontend:
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

FLASK_DEBUG=1
