# Copiá este archivo como ".env" y ajustá los valores. El ".env" NO se sube a git.

# Dónde está corriendo el API (el backend de Flask).
API_BASE_URL=http://localhost:5000/api/v1

# Clave para firmar la cookie de sesión. En producción tiene que ser larga y secreta.
# Para generar una:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiame-por-una-clave-larga-y-secreta

# Segundos máximos de espera al API antes de mostrar "servicio no disponible".
API_TIMEOUT=8

# Poner en 1 cuando el front se sirva por HTTPS (la cookie viaja solo cifrada).
SESSION_COOKIE_SECURE=0
